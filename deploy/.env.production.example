# Copy to deploy/.env.production and fill in real values. Never commit the
# filled-in file: .gitignore already excludes .env.* .
#
#   cp deploy/.env.production.example deploy/.env.production

# Port Nginx binds on the host. Keep 80 when a TLS terminator sits in front,
# or set 8080 and let an external proxy forward to it.
HTTP_PORT=80

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=sippilot
POSTGRES_USER=sippilot
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Edge API ---------------------------------------------------------------
# Must be at least 32 UTF-8 bytes. Generate with: openssl rand -hex 32
# Rotating this invalidates every issued staff token.
JWT_SECRET=
JWT_ISSUER=smart-drink-edge
JWT_AUDIENCE=smart-drink-operations

LOG_LEVEL=INFO

# --- Locale -----------------------------------------------------------------
BUSINESS_TIMEZONE=Europe/Amsterdam
DEFAULT_COUNTRY=NL
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=nl-NL
