<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sippilot.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__LAUNCHER_ROOT__/keep-services.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__LAUNCH_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SIPPILOT_PROJECT_ROOT</key>
    <string>__LAUNCH_ROOT__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/launch-agent.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/launch-agent.stderr.log</string>
</dict>
</plist>
