APP_NAME=Smart Drink Edge API
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
DEFAULT_COUNTRY=NL
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=nl-NL
BUSINESS_TIMEZONE=Europe/Amsterdam

DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
