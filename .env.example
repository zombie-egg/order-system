APP_NAME=Smart Drink Edge API
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
# dev.ps1 reads API_PORT and the three frontend port values below;
# explicit script parameters take precedence.
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

JWT_SECRET=development-only-change-before-production
JWT_ISSUER=smart-drink-edge
JWT_AUDIENCE=smart-drink-operations
ACCESS_TOKEN_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_PASSWORD_VERIFY_CONCURRENCY=4
QUOTE_TTL_SECONDS=900
KDS_ONLINE_WINDOW_SECONDS=30
MOCK_PAYMENT_ENABLED=true
MOCK_PAYMENT_SCENARIO=APPROVED
# Staging/production must use a secret of at least 32 characters,
# MOCK_PAYMENT_ENABLED=false, and a postgresql+psycopg DATABASE_URL.

DEFAULT_COUNTRY=NL
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=nl-NL
BUSINESS_TIMEZONE=Europe/Amsterdam

DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# Development PostgreSQL example only; do not reuse this credential in production.
# DATABASE_URL=postgresql+psycopg://smartdrink:smartdrink@127.0.0.1:5432/smartdrink?connect_timeout=10

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]

KIOSK_PORT=5173
KITCHEN_DISPLAY_PORT=5174
ADMIN_PORT=5175
